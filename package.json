{
  "name": "kirthiverse-web",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "KirthiVerse - Premium Educational Platform",
  "scripts": {
    "generate:learning-index": "node scripts/generate-learning-index.mjs",
    "predev": "pnpm run generate:learning-index",
    "dev": "vite",
    "prebuild": "pnpm run generate:learning-index",
    "build": "node scripts/validate-public-identity.mjs && vite build && node scripts/copy-static-production-files.mjs && node scripts/validate-bundle-budget.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:kvs-supplement": "node scripts/validate-kvs-production-supplement.mjs",
    "validate:experience": "node scripts/validate-experience.mjs",
    "validate:trust": "node scripts/validate-trust.mjs",
    "validate:data": "node scripts/validate-data-lifecycle.mjs",
    "validate:a11y": "node scripts/validate-accessibility.mjs",
    "validate:contract": "node scripts/validate-release-contract.mjs",
    "validate:web": "node scripts/validate-release-contract.mjs",
    "validate:release": "node scripts/validate-release-contract.mjs",
    "validate:pwa": "node scripts/validate-release-contract.mjs",
    "validate:ops": "node scripts/validate-release-contract.mjs",
    "validate:runtime": "node scripts/validate-release-contract.mjs",
    "validate:identity": "node scripts/validate-public-identity.mjs",
    "validate:cloud-identity": "node scripts/validate-cloud-identity-preview.mjs",
    "test:cloud-identity-api": "node scripts/test-cloud-identity-api-preview.mjs",
    "validate:adult-auth": "node scripts/validate-adult-auth-boundary.mjs",
    "validate:external-verifier": "node scripts/validate-external-provider-verifier.mjs",
    "validate:trusted-role-resolver": "node scripts/validate-trusted-role-resolver.mjs",
    "validate:guardian-consent": "node scripts/validate-guardian-consent-ledger.mjs",
    "validate:tenant-isolation": "node scripts/validate-tenant-isolation-boundary.mjs",
    "validate:encryption-boundary": "node scripts/validate-encryption-key-boundary.mjs",
    "validate:session-security": "node scripts/validate-session-revocation-replay-boundary.mjs",
    "validate:audit-boundary": "node scripts/validate-audit-boundary.mjs",
    "validate:data-lifecycle-boundary": "node scripts/validate-data-lifecycle-boundary.mjs",
    "validate:rate-limiting-abuse": "node scripts/validate-rate-limiting-abuse-boundary.mjs",
    "validate:dist": "node scripts/validate-dist.mjs",
    "validate:bundle": "node scripts/validate-bundle-budget.mjs",
    "package:preview": "node scripts/create-local-preview-package.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:live": "node scripts/live-site-smoke.mjs",
    "preview": "vite preview",
    "pretype-check": "pnpm run generate:learning-index",
    "type-check": "tsc --noEmit",
    "prelint": "pnpm run generate:learning-index",
    "lint": "eslint src --ext .ts,.tsx",
    "check": "pnpm run validate:content && pnpm run validate:kvs-supplement && pnpm run validate:experience && pnpm run validate:trust && pnpm run validate:data && pnpm run validate:a11y && pnpm run validate:identity && pnpm run validate:cloud-identity && pnpm run test:cloud-identity-api && pnpm run validate:adult-auth && pnpm run validate:external-verifier && pnpm run validate:trusted-role-resolver && pnpm run validate:guardian-consent && pnpm run validate:tenant-isolation && pnpm run validate:encryption-boundary && pnpm run validate:session-security && pnpm run validate:audit-boundary && pnpm run validate:data-lifecycle-boundary && pnpm run validate:rate-limiting-abuse && pnpm run validate:contract && pnpm run type-check && pnpm run lint && pnpm run build && pnpm run validate:dist",
    "format": "prettier --write ."
  },
  "dependencies": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "wouter": "^3.3.5",
    "framer-motion": "^12.23.22",
    "recharts": "^2.15.2",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.453.0",
    "zod": "^4.1.12",
    "react-hook-form": "^7.64.0",
    "@hookform/resolvers": "^5.2.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "clsx": "^2.1.1",
    "class-variance-authority": "^0.7.1"
  },
  "packageManager": "pnpm@11.23.0",
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/node": "^24.7.0",
    "vite": "^7.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "@tailwindcss/vite": "^4.1.3",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20",
    "prettier": "^3.6.2",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "globals": "^15.0.0",
    "eslint-plugin-react": "^7.32.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  }
}
