{
  "name": "kirthiverse-web",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "KirthiVerse - Premium Educational Platform",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-static-production-files.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:kvs-supplement": "node scripts/validate-kvs-production-supplement.mjs",
    "validate:experience": "node scripts/validate-experience.mjs",
    "validate:trust": "node scripts/validate-trust.mjs",
    "validate:data": "node scripts/validate-data-lifecycle.mjs",
    "validate:a11y": "node scripts/validate-accessibility.mjs",
    "validate:web": "node scripts/validate-web-quality.mjs",
    "validate:release": "node scripts/validate-release-readiness.mjs",
    "validate:pwa": "node scripts/validate-pwa-contract.mjs",
    "validate:ops": "node scripts/validate-release-operations.mjs",
    "validate:entry": "node scripts/validate-entry-recovery.mjs",
    "validate:runtime": "node scripts/validate-runtime-recovery.mjs",
    "validate:dist": "node scripts/validate-dist.mjs",
    "package:preview": "node scripts/create-local-preview-package.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:live": "node scripts/live-site-smoke.mjs",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "check": "pnpm run validate:content && pnpm run validate:kvs-supplement && pnpm run validate:experience && pnpm run validate:trust && pnpm run validate:data && pnpm run validate:a11y && pnpm run validate:web && pnpm run validate:release && pnpm run validate:pwa && pnpm run validate:ops && pnpm run validate:entry && pnpm run validate:runtime && pnpm run type-check && pnpm run lint && pnpm run build && pnpm run validate:dist",
    "format": "prettier --write ."
  },
  "dependencies": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "wouter": "^3.3.5",
    "framer-motion": "^12.23.22",
    "recharts": "^2.15.2",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.453.0",
    "zod": "^4.1.12",
    "react-hook-form": "^7.64.0",
    "@hookform/resolvers": "^5.2.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "clsx": "^2.1.1",
    "class-variance-authority": "^0.7.1"
  },
  "packageManager": "pnpm@11.13.0",
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/node": "^24.7.0",
    "vite": "^7.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "@tailwindcss/vite": "^4.1.3",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20",
    "prettier": "^3.6.2",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "globals": "^15.0.0",
    "eslint-plugin-react": "^7.32.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  }
}
